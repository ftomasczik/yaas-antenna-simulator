msgstr "PyNEC: OK"

msgid "Antenna simulator based on NEC2++."
msgstr "Simulador de antenas basado en NEC2++."

msgid "Interface language: en or es."
msgstr "Idioma de la interfaz: en o es."

msgid "commands"
msgstr "comandos"

msgid "Check the runtime environment."
msgstr "Comprueba el entorno de ejecución."

msgid "Frequency: {frequency:.3f} MHz"
msgstr "Frecuencia: {frequency:.3f} MHz"

msgid "Impedance: {real:.2f} {imag:+.2f}j ohm"
msgstr "Impedancia: {real:.2f} {imag:+.2f}j ohm"

msgid "SWR relative to {reference:.0f} ohm: {swr:.2f}"
msgstr "ROE respecto de {reference:.0f} ohm: {swr:.2f}"

msgid "Error: {error}"
msgstr "Error: {error}"

msgid "Sweep: {start:.3f}-{stop:.3f} MHz"
msgstr "Barrido: {start:.3f}-{stop:.3f} MHz"

msgid "Points: {points}"
msgstr "Puntos: {points}"

msgid "SWR"
msgstr "ROE"

msgid "Bandwidth: no interval with SWR <= {limit:.2f}"
msgstr "Ancho de banda: no existe un intervalo con ROE <= {limit:.2f}"

msgid "Bandwidth for SWR <= {limit:.2f}"
msgstr "Ancho de banda para ROE <= {limit:.2f}"

msgid "Bandwidth for SWR <= {limit:.2f}: truncated; the interval may extend beyond the sweep."
msgstr "Ancho de banda para ROE <= {limit:.2f}: truncado; el intervalo puede extenderse más allá del barrido."

msgid "Lower frequency"
msgstr "Frecuencia inferior"

msgid "Upper frequency"
msgstr "Frecuencia superior"

msgid "outside the sweep"
msgstr "fuera del barrido"

msgid "Approximate resonance: at the edge of the sweep; the actual resonance may lie outside the swept range."
msgstr "Resonancia aproximada: en el límite del barrido; la resonancia real puede quedar fuera del barrido."

msgid "Minimum SWR observed at the edge of the sweep"
msgstr "ROE mínima observada en el límite del barrido"

msgid "Bandwidth"
msgstr "Ancho"

msgid "Fractional bandwidth"
msgstr "Ancho porcentual"

msgid "CSV file"
msgstr "Archivo CSV"

msgid "Simulate the built-in reference dipole."
msgstr "Simula el dipolo interno de referencia."

msgid "Sweep frequencies over the reference dipole."
msgstr "Barre frecuencias sobre el dipolo de referencia."

msgid "Start frequency in MHz (default: 13.0)."
msgstr "Frecuencia inicial en MHz (predeterminado: 13.0)."

msgid "Stop frequency in MHz (default: 16.0)."
msgstr "Frecuencia final en MHz (predeterminado: 16.0)."

msgid "Number of points (default: 61)."
msgstr "Cantidad de puntos (predeterminado: 61)."

msgid "SWR limit for bandwidth calculation (default: 2.0)."
msgstr "Límite de ROE para el ancho de banda (predeterminado: 2.0)."

msgid "CSV file where the sweep will be saved."
msgstr "Archivo CSV donde guardar el barrido."

msgid "The SWR limit must be finite and greater than or equal to 1."
msgstr "El límite de ROE debe ser finito y mayor o igual a 1."

msgid "Validate an AntSim project file."
msgstr "Validar un archivo de proyecto AntSim."

msgid "AntSim project file to validate."
msgstr "Archivo de proyecto AntSim que se validará."

msgid "Invalid project: {error}"
msgstr "Proyecto inválido: {error}"

msgid "Valid project: {path}"
msgstr "Proyecto válido: {path}"

msgid "Project name: {name}"
msgstr "Nombre del proyecto: {name}"

msgid "Schema version: {version}"
msgstr "Versión del esquema: {version}"

msgid "Wires: {count}"
msgstr "Conductores: {count}"

msgid "Simulate an AntSim project file."
msgstr "Simular un archivo de proyecto AntSim."

msgid "AntSim project file to simulate."
msgstr "Archivo de proyecto AntSim que se simulará."

msgid "Simulating project: {name}"
msgstr "Simulando proyecto: {name}"

msgid "Sweep frequencies for an AntSim project."
msgstr "Realizar un barrido de frecuencias para un proyecto AntSim."

msgid "AntSim project file to sweep."
msgstr "Archivo de proyecto AntSim que se barrerá."

msgid "Sweeping project: {name}"
msgstr "Ejecutando barrido del proyecto: {name}"

msgid "Export an AntSim project as a NEC file."
msgstr "Exportar un proyecto AntSim como archivo NEC."

msgid "AntSim project file to export."
msgstr "Archivo de proyecto AntSim que se exportará."

msgid "Destination NEC file."
msgstr "Archivo NEC de destino."

msgid "Could not write NEC file: {error}"
msgstr "No se pudo escribir el archivo NEC: {error}"

msgid "NEC file: {path}"
msgstr "Archivo NEC: {path}"

msgid "Export the frequency sweep configured in the project."
msgstr "Exportar el barrido de frecuencias configurado en el proyecto."

msgid "Inspect a Touchstone S1P measurement."
msgstr "Inspeccionar una medición Touchstone S1P."

msgid "Touchstone S1P file to inspect."
msgstr "Archivo Touchstone S1P que se inspeccionará."

msgid "Invalid measurement: {error}"
msgstr "Medición inválida: {error}"

msgid "Measurement: {path}"
msgstr "Medición: {path}"

msgid "Frequency range: {start:.3f}-{stop:.3f} MHz"
msgstr "Rango de frecuencias: {start:.3f}-{stop:.3f} MHz"

msgid "Reference impedance: {reference:.2f} ohm"
msgstr "Impedancia de referencia: {reference:.2f} ohm"

msgid "Warning: reactance does not cross zero within the measured range."
msgstr "Advertencia: la reactancia no cruza por cero dentro del rango medido."

msgid "Warning: minimum SWR is at the edge of the measured range."
msgstr "Advertencia: la ROE mínima está en un extremo del rango medido."

msgid "Approximate resonance: unavailable; no points have finite impedance."
msgstr "Resonancia aproximada: no disponible; no hay puntos con impedancia finita."

msgid "Compare an AntSim project against a Touchstone measurement."
msgstr "Comparar un proyecto AntSim con una medición Touchstone."

msgid "AntSim project file to compare."
msgstr "Archivo de proyecto AntSim que se comparará."

msgid "Touchstone S1P file to compare against."
msgstr "Archivo Touchstone S1P con el que se comparará."

msgid "Reference impedance used for the comparison, in ohms."
msgstr "Impedancia de referencia utilizada en la comparación, en ohms."

msgid "CSV file where the comparison will be saved."
msgstr "Archivo CSV donde se guardará la comparación."

msgid "Comparing project: {name}"
msgstr "Comparando proyecto: {name}"

msgid "Measurement file: {path}"
msgstr "Archivo de medición: {path}"

msgid "Compared points: {count}"
msgstr "Puntos comparados: {count}"

msgid "Measured points excluded (out of range): {count}"
msgstr "Puntos medidos excluidos (fuera de rango): {count}"

msgid "Points requiring interpolation: {count}"
msgstr "Puntos que requirieron interpolación: {count}"

msgid "Largest SWR difference"
msgstr "Mayor diferencia de ROE"

msgid "Magnitude"
msgstr "Magnitud"

msgid "Import a MMANA-GAL .maa file as an AntSim project."
msgstr "Importar un archivo MMANA-GAL .maa como proyecto AntSim."

msgid "MMANA-GAL .maa file to import."
msgstr "Archivo MMANA-GAL .maa que se importará."

msgid "AntSim project file to create."
msgstr "Archivo de proyecto AntSim que se creará."

msgid "Sweep start frequency, in MHz. The MMANA-GAL format does not carry a sweep definition, so this value must always be provided explicitly."
msgstr "Frecuencia inicial de barrido, en MHz. El formato MMANA-GAL no incluye una definición de barrido, por lo que este valor siempre debe indicarse explícitamente."

msgid "Sweep stop frequency, in MHz."
msgstr "Frecuencia final de barrido, en MHz."

msgid "Number of points in the sweep."
msgstr "Cantidad de puntos del barrido."

msgid "SWR limit used for bandwidth calculations."
msgstr "Límite de ROE utilizado para el cálculo de ancho de banda."

msgid "Legacy 8-bit encoding to use when the file is not UTF-8 and the encoding is ambiguous between CP1251 and CP1252."
msgstr "Codificación heredada de 8 bits a usar cuando el archivo no es UTF-8 y la codificación es ambigua entre CP1251 y CP1252."

msgid "Overwrite the destination file if it already exists."
msgstr "Sobrescribir el archivo de destino si ya existe."

msgid "Invalid sweep settings: {error}"
msgstr "Configuración de barrido inválida: {error}"

msgid "MMANA-GAL import failed: {error}"
msgstr "Error al importar el archivo MMANA-GAL: {error}"

msgid "Incompatible MMANA-GAL model:"
msgstr "Modelo MMANA-GAL incompatible:"

msgid "Invalid MMANA-GAL file: {error}"
msgstr "Archivo MMANA-GAL inválido: {error}"

msgid "Destination already exists: {path}"
msgstr "El destino ya existe: {path}"

msgid "Use --force to overwrite it."
msgstr "Use --force para sobrescribirlo."

msgid "MMANA-GAL project imported successfully."
msgstr "Proyecto MMANA-GAL importado correctamente."

msgid "Source"
msgstr "Origen"

msgid "Destination"
msgstr "Destino"

msgid "Encoding"
msgstr "Codificación"

msgid "Project"
msgstr "Proyecto"

msgid "Warnings: {count}"
msgstr "Advertencias: {count}"

msgid "Unique warnings: {count}"
msgstr "Advertencias únicas: {count}"

msgid "Warning [{code}]:"
msgstr "Advertencia [{code}]:"

msgid "Warning [{code}] ({occurrences} occurrences):"
msgstr "Advertencia [{code}] ({occurrences} apariciones):"

msgid "The comment section is present but empty."
msgstr "La sección de comentario está presente pero vacía."

msgid "The requested pattern azimuth and elevation will not be preserved."
msgstr "El azimut y la elevación de diagrama solicitados no se conservarán."

msgid "The additional height above ground is not a finite number."
msgstr "La altura adicional sobre el suelo no es un número finito."

msgid "Only free-space models are supported; ground models cannot be imported."
msgstr "Solo se admiten modelos en espacio libre; los modelos con tierra no pueden importarse."

msgid "The main frequency must be a finite, positive number."
msgstr "La frecuencia principal debe ser un número finito y positivo."

msgid "Concentrated loads are not supported yet."
msgstr "Las cargas concentradas todavía no están admitidas."

msgid "The reference impedance must be a finite, positive number."
msgstr "La impedancia de referencia debe ser un número finito y positivo."

msgid "A section header does not match any recognized variant."
msgstr "Un encabezado de sección no coincide con ninguna variante reconocida."

msgid "The global segmentation parameters (DM1, DM2, SC, EC) are invalid."
msgstr "Los parámetros globales de segmentación (DM1, DM2, SC, EC) son inválidos."

msgid "MMANA-GAL tapered segmentation cannot be reproduced exactly; AntSim uses uniform segmentation instead."
msgstr "La segmentación cónica de MMANA-GAL no puede reproducirse exactamente; AntSim usa en su lugar segmentación uniforme."

msgid "Exactly one source is required."
msgstr "Se requiere exactamente una fuente."

msgid "The source must be centered on its conductor, without any pulse offset."
msgstr "La fuente debe estar centrada en su conductor, sin desplazamiento de pulso."

msgid "The source phase must be a finite number."
msgstr "La fase de la fuente debe ser un número finito."

msgid "The source phase is different from zero."
msgstr "La fase de la fuente es distinta de cero."

msgid "The source voltage must be a finite number different from zero."
msgstr "La tensión de la fuente debe ser un número finito distinto de cero."

msgid "The document title is empty."
msgstr "El título del documento está vacío."

msgid "A conductor has non-finite coordinates or zero length."
msgstr "Un conductor tiene coordenadas no finitas o longitud cero."

msgid "A conductor radius must be a finite, positive number."
msgstr "El radio de un conductor debe ser un número finito y positivo."

msgid "A source or load has an invalid conductor reference."
msgstr "Una fuente o carga tiene una referencia de conductor inválida."

msgid "A source or load references a conductor that does not exist."
msgstr "Una fuente o carga hace referencia a un conductor que no existe."

msgid "This conductor's manual segmentation mode is not supported yet."
msgstr "Este modo de segmentación manual del conductor todavía no está admitido."

msgid "Invalid comparison: {error}"
msgstr "Comparación inválida: {error}"
